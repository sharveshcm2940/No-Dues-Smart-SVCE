MYSQL_ROOT_PASSWORD=svce_dev_root_pwd_2026
DB_CONNECTION_LIMIT=50
DB_MAX_IDLE=25

JWT_SECRET=svce_nodues_dev_jwt_secret_min_32_chars_long!
