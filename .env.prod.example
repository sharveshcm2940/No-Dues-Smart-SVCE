# ==============================================================================
# SVCE Smart No-Dues ERP - Production Environment Template (.env.prod)
# DO NOT COMMIT REAL PASSWORDS OR KEYS TO GIT!
# Copy this file to .env.prod on the server: cp .env.prod.example .env.prod
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# MySQL Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=svce_nodues
DB_USER=svce_app
DB_PASSWORD=REPLACE_WITH_SECURE_MYSQL_APP_PASSWORD_MIN_24_CHARS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SECURE_MYSQL_ROOT_PASSWORD_MIN_24_CHARS
DB_CONNECTION_LIMIT=50
DB_MAX_IDLE=25

# Cryptographic Keys (Must be minimum 32 random characters/bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_JWT_SECRET_MIN_32_BYTES
CERT_HMAC_KEY=REPLACE_WITH_SECURE_RANDOM_CERT_HMAC_KEY_MIN_32_BYTES
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SESSION_SECRET_MIN_32_BYTES
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_SECURE_RANDOM_BACKUP_PASSPHRASE_MIN_32_BYTES

# Network & Proxy
CORS_ORIGINS=https://nodues.svce.ac.in
TRUST_PROXY=1
LOG_LEVEL=info

# Backup Retention
BACKUP_RETENTION_DAYS=30
